# OpenAlex API key for higher rate limits (optional; omitted if empty)
OPENALEX_API_KEY=

# Semantic Scholar API key for literature search (optional)
S2_API_KEY=

# Groq API key for optional LLM synthesis pass (optional)
GROQ_API_KEY=

# Google Gemini API key for optional LLM synthesis pass (optional)
GEMINI_API_KEY=

# OpenAI API key for optional LLM synthesis pass (optional)
OPENAI_API_KEY=

# Anthropic API key for optional LLM synthesis pass (optional)
ANTHROPIC_API_KEY=

# Polite contact email for OpenAlex, Crossref, and Europe PMC User-Agent/mailto (optional)
CONTACT_EMAIL=

# Test-only flag: set to 1 by scripts/run-offline-tests.js to skip live network enrichment
PREPPT_OFFLINE=
